<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework><AssemblyName>WildWastelandDeveloper</AssemblyName><RootNamespace>WildWastelandDeveloper</RootNamespace>
    <LangVersion>7.3</LangVersion><Nullable>disable</Nullable><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoStdLib>true</NoStdLib><NoCompilerStandardLib>true</NoCompilerStandardLib><DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <GameDir Condition="'$(GameDir)' == ''">E:\SteamLibrary\steamapps\common\Apocalypter</GameDir>
    <ManagedDir>$(GameDir)\Apocalypter_Data\Managed</ManagedDir><BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <FrameworkPathOverride>$(ManagedDir)</FrameworkPathOverride>
    <AssemblySearchPaths>{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName}</AssemblySearchPaths>
  </PropertyGroup>
  <ItemGroup><Compile Include="*.cs" /></ItemGroup>
  <ItemGroup>
    <Reference Include="WildWasteland"><HintPath>..\bin\Release\WildWasteland.dll</HintPath><Private>false</Private></Reference>

